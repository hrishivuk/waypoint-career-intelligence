# Server-only OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=

# Server-only Groq configuration. GROQ_MODEL is the shared default; the
# task-specific values are optional overrides.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_CV_EXTRACTION_MODEL=
GROQ_JD_PARSING_MODEL=
GROQ_JOB_MATCHING_MODEL=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fixed prototype identity. Replace this adapter with Supabase Auth for beta.
PROTOTYPE_USER_ID=00000000-0000-4000-8000-000000000001
