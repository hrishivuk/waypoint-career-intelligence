# Server-only OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=

# Server-only Groq configuration. GROQ_MODEL is the shared default; the
# task-specific values are optional overrides.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_CV_EXTRACTION_MODEL=
GROQ_JD_PARSING_MODEL=
GROQ_JOB_MATCHING_MODEL=

# Server-only per-user AI credential encryption keyring. Generate each value
# with: openssl rand -base64 32. Keep retired versions here until all stored
# credentials have been rotated to the current version.
AI_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
AI_CREDENTIAL_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
